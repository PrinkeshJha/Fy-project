{
  "manifest_version": 3,
  "name": "AI Phishing Detector",
  "version": "1.0.0",
  "description": "Real-time phishing detection using AI",

  "permissions": [
    "activeTab",
    "tabs"
  ],

  "host_permissions": [
    "http://localhost:8000/*"
  ],

  "action": {
    "default_popup": "pop.html",
    "default_icon": {
      "16": "icons/secure16.png",
      "48": "icons/secure48.png",
      "128":"icons/secure128.png"
    }
  },

  "icons": {
    "16": "icons/secure16.png",
    "48": "icons/secure48.png",
    "128":"icons/secure128.png"
  }
}
